# Supabase project URL and public key. These ship to the browser, which is why
# Row Level Security has to be on (see supabase/rls.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS, so it must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Admin console password. No default: if this is unset, all admin access is denied.
ADMIN_PASSWORD=
